{% extends 'layout.html.twig' %}

{% block content %}
    <h1>{{ title }}</h1>
    <h2>{{ isEdit ? 'Редактирование' : 'Добавление' }} фильма или сериала</h2>

    <form action="{{ isEdit ? 'edit.php' : 'save.php' }}" method="POST">
        {% if isEdit and movie.id is defined %}
            <input type="hidden" name="id" value="{{ movie.id }}">
        {% endif %}
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        
        <label for="title">Название</label>
        <input type="text" id="title" name="title" required minlength="2" maxlength="100"
               value="{{ movie.title|default('')|e }}">
        
        <label for="release_date">Дата выхода</label>
        <input type="date" id="release_date" name="release_date" required
               value="{{ movie.release_date|default('')|e }}">
        
        <label for="type">Тип</label>
        <select id="type" name="type" required>
            <option value="">Выберите тип</option>
            {% for t in types %}
                <option value="{{ t|e }}" {{ movie.type|default('') == t ? 'selected' : '' }}>
                    {{ t|e }}
                </option>
            {% endfor %}
        </select>
        
        <label for="genre_id">Жанр</label>
        <select id="genre_id" name="genre_id" required>
            <option value="">Выберите жанр</option>
            {% for g in genres %}
                <option value="{{ g.id }}" {{ movie.genre_id|default(0) == g.id ? 'selected' : '' }}>
                    {{ g.name|e }}
                </option>
            {% endfor %}
        </select>
        
        <label for="rating">Оценка</label>
        <input type="number" id="rating" name="rating" min="1" max="10" required
               value="{{ movie.rating|default('')|e }}">
        
        <label for="description">Описание</label>
        <textarea id="description" name="description" required minlength="10" maxlength="1000">{{ movie.description|default('')|e }}</textarea>
        
        <label for="watched_at">Дата просмотра</label>
        <input type="date" id="watched_at" name="watched_at"
               value="{{ movie.watched_at|default('')|e }}">
        
        <label for="status">Статус</label>
        <select id="status" name="status" required>
            <option value="">Выберите статус</option>
            {% for s in statuses %}
                <option value="{{ s|e }}" {{ movie.status|default('') == s ? 'selected' : '' }}>
                    {{ s|e }}
                </option>
            {% endfor %}
        </select>
        
        <button type="submit">{{ isEdit ? 'Обновить' : 'Сохранить' }} запись</button>
    </form>
    
    <div class="actions">
        <a href="list.php">Посмотреть список фильмов и сериалов</a>
    </div>
{% endblock %}